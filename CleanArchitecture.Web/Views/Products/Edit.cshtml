@model CleanArchitecture.Application.DTOs.CreateProductDto

@{
    ViewData["Title"] = "Edit product";
}

<div class="page-head">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="panel panel-pad">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="validation-summary mb-3"></div>

                <input asp-for="Status" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Alder Task Chair" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional"></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control num" placeholder="0.00" step="0.01" />
                        </div>
                        <span asp-validation-for="Price" class="field-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="StockQuantity" class="form-label"></label>
                        <input asp-for="StockQuantity" class="form-control num" placeholder="0" />
                        <span asp-validation-for="StockQuantity" class="field-error"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="Category" class="form-label"></label>
                        <input asp-for="Category" class="form-control" placeholder="Optional" />
                        <span asp-validation-for="Category" class="field-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="CustomerId" class="form-label"></label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                            <option value="">Select a customer</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="field-error"></span>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-link px-0">
                        <i class="bi bi-chevron-left"></i> Back to products
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-quiet">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
