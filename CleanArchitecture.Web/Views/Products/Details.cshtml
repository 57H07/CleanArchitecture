@model CleanArchitecture.Application.DTOs.ProductDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="page-head">
    <h1>@Model.Name</h1>
    <div class="d-flex align-items-center gap-2">
        @if (!Model.IsAvailable)
        {
            <span class="status status-neutral">Unavailable</span>
        }
        else if (!Model.IsInStock)
        {
            <span class="status status-danger">Out of stock</span>
        }
        else
        {
            <span class="status status-positive">Available</span>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="panel panel-pad">
            <dl class="row detail-list">
                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9 mb-2">@Model.Price.ToString("C")</dd>

                <dt class="col-sm-3">Stock</dt>
                <dd class="col-sm-9 mb-2">
                    @if (Model.IsInStock)
                    {
                        <text>@Model.StockQuantity units</text>
                    }
                    else
                    {
                        <span class="status status-danger">Out of stock</span>
                    }
                </dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9 mb-2">
                    @if (!string.IsNullOrEmpty(Model.Category))
                    {
                        <span class="tag">@Model.Category</span>
                    }
                    else
                    {
                        <span class="text-muted">No category</span>
                    }
                </dd>

                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9 mb-2">@Model.CustomerName</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9 mb-2">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        @Model.Description
                    }
                    else
                    {
                        <span class="text-muted">No description</span>
                    }
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 mb-2">@Model.CreatedAt.ToString("dd MMMM yyyy 'at' HH:mm")</dd>

                <dt class="col-sm-3">Last updated</dt>
                <dd class="col-sm-9 mb-0">
                    @if (Model.UpdatedAt.HasValue)
                    {
                        @Model.UpdatedAt.Value.ToString("dd MMMM yyyy 'at' HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">Never updated</span>
                    }
                </dd>
            </dl>

            <div class="form-actions mt-4">
                <a asp-action="Index" class="btn btn-link px-0">
                    <i class="bi bi-chevron-left"></i> Back to products
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-quiet">Delete</a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit product</a>
                </div>
            </div>
        </div>
    </div>

</div>
