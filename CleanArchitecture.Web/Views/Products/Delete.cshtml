@model CleanArchitecture.Application.DTOs.ProductDto

@{
    ViewData["Title"] = "Delete product";
}

<div class="page-head">
    <h1>Delete @Model.Name</h1>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="panel panel-pad">
            <div class="alert-inline mb-4">
                <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
                <div>Deleting this product removes it permanently, along with everything associated with it. This cannot be undone.</div>
            </div>

            <dl class="row detail-list">
                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9 mb-2">@Model.Price.ToString("C")</dd>

                <dt class="col-sm-3">Stock</dt>
                <dd class="col-sm-9 mb-2">
                    @if (Model.IsInStock)
                    {
                        <text>@Model.StockQuantity units</text>
                    }
                    else
                    {
                        <span class="status status-danger">Out of stock</span>
                    }
                </dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9 mb-2">
                    @if (!string.IsNullOrEmpty(Model.Category))
                    {
                        <span class="tag">@Model.Category</span>
                    }
                    else
                    {
                        <span class="text-muted">No category</span>
                    }
                </dd>

                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9 mb-2">@Model.CustomerName</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 mb-0">@Model.CreatedAt.ToString("dd MMMM yyyy")</dd>
            </dl>

            <div class="form-actions mt-4">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link px-0">
                    <i class="bi bi-chevron-left"></i> Back to details
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-quiet">Keep product</a>
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Delete product</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
