@using CleanArchitecture.Application.Enums
@model CleanArchitecture.Web.ViewModels.ProductsViewModel

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Product
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="searchTerm">Search</label>
                <input type="text" class="form-control" id="searchTerm" name="searchTerm" value="@Model.Filter.SearchTerm" placeholder="Name or description" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="category">Category</label>
                <select class="form-select" id="category" name="category" asp-items="Model.AvailableCategories">
                    <option value="">All categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="status">Status</label>
                <select class="form-select" id="status" name="status" asp-items="Model.AvailableStatuses">
                    <option value="">All statuses</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="customerId">Customer</label>
                <select class="form-select" id="customerId" name="customerId" asp-items="Model.AvailableCustomers">
                    <option value="">All customers</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="pageSize">Page size</label>
                <select class="form-select" id="pageSize" name="pageSize">
                    @foreach (var size in new[] { 5, 10, 25, 50 })
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                    }
                </select>
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>

            @* Applying a filter always returns to page 1: the current page may not exist in the new result set. *@
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="sortBy" value="@Model.Filter.SortBy" />
            <input type="hidden" name="sortOrder" value="@Model.Filter.SortOrder" />

            @if (Model.Filter.HasActiveFilters)
            {
                <div class="col-12">
                    <a asp-action="Index" class="btn btn-sm btn-link px-0">
                        <i class="bi bi-x-circle"></i> Clear filters
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.HasResults)
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-all-route-data="Model.GetSortRouteValues(ProductSortBy.Name)" class="text-white text-decoration-none">
                                    Name <i class="bi @Model.GetSortIcon(ProductSortBy.Name)"></i>
                                </a>
                            </th>
                            <th>Category</th>
                            <th>
                                <a asp-action="Index" asp-all-route-data="Model.GetSortRouteValues(ProductSortBy.Price)" class="text-white text-decoration-none">
                                    Price <i class="bi @Model.GetSortIcon(ProductSortBy.Price)"></i>
                                </a>
                            </th>
                            <th>Stock</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>
                                <a asp-action="Index" asp-all-route-data="Model.GetSortRouteValues(ProductSortBy.CreatedDate)" class="text-white text-decoration-none">
                                    Created <i class="bi @Model.GetSortIcon(ProductSortBy.CreatedDate)"></i>
                                </a>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td>
                                    <strong>@product.Name</strong>
                                    @if (!string.IsNullOrEmpty(product.Description))
                                    {
                                        <br><small class="text-muted">@product.Description.Substring(0, Math.Min(50, product.Description.Length))@(product.Description.Length > 50 ? "..." : "")</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.Category))
                                    {
                                        <span class="badge bg-info">@product.Category</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No category</span>
                                    }
                                </td>
                                <td>
                                    <strong>@product.Price.ToString("C")</strong>
                                </td>
                                <td>
                                    @if (product.IsInStock)
                                    {
                                        <span class="badge bg-success">@product.StockQuantity in stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out of stock</span>
                                    }
                                </td>
                                <td>@product.CustomerName</td>
                                <td>
                                    @if (product.IsAvailable)
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Unavailable</span>
                                    }
                                </td>
                                <td>@product.CreatedAt.ToString("MM/dd/yyyy")</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                                <i class="bi bi-boxes"></i> Stock
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <form asp-action="UpdateStock" asp-route-id="@product.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="quantity" value="10" />
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi bi-plus-circle text-success"></i> Add 10
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="UpdateStock" asp-route-id="@product.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="quantity" value="-5" />
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi bi-dash-circle text-warning"></i> Remove 5
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <div class="text-muted small">
                    Showing @Model.StartItem-@Model.EndItem of @Model.TotalItems products
                </div>

                @if (Model.HasMultiplePages)
                {
                    <nav aria-label="Products pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-all-route-data="Model.GetPageRouteValues(1)">
                                    <i class="bi bi-chevron-double-left"></i>
                                </a>
                            </li>
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-all-route-data="Model.GetPageRouteValues(Model.CurrentPage - 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @{
                                var startPage = Math.Max(1, Model.CurrentPage - 2);
                                var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                            }
                            @for (var i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-all-route-data="Model.GetPageRouteValues(i)">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-all-route-data="Model.GetPageRouteValues(Model.CurrentPage + 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-all-route-data="Model.GetPageRouteValues(Model.TotalPages)">
                                    <i class="bi bi-chevron-double-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h4 class="text-muted">@Model.NoResultsMessage</h4>
                <p class="text-muted">Try adjusting your filters, or create your first product to get started.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create New Product
                </a>
            </div>
        }
    </div>
</div>
