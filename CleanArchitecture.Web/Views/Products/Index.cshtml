@using CleanArchitecture.Application.Enums
@model CleanArchitecture.Web.ViewModels.ProductsViewModel

@{
    ViewData["Title"] = "Products";
}

<div class="page-head">
    <h1>Products</h1>
    <div class="d-flex align-items-center gap-3">
        <span class="page-count">@Model.TotalItems @(Model.TotalItems == 1 ? "product" : "products")</span>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New product
        </a>
    </div>
</div>

<form asp-action="Index" method="get" class="toolbar row g-2 align-items-end">
    <div class="col-12 col-md-4 col-lg-3">
        <label class="form-label" for="searchTerm">Search</label>
        <input type="text" class="form-control" id="searchTerm" name="searchTerm" value="@Model.Filter.SearchTerm" placeholder="Name or description" />
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label" for="category">Category</label>
        <select class="form-select" id="category" name="category" asp-items="Model.AvailableCategories">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label" for="status">Status</label>
        <select class="form-select" id="status" name="status" asp-items="Model.AvailableStatuses">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label" for="customerId">Customer</label>
        <select class="form-select" id="customerId" name="customerId" asp-items="Model.AvailableCustomers">
            <option value="">All customers</option>
        </select>
    </div>
    <div class="col-6 col-md-2 col-lg-1">
        <label class="form-label" for="pageSize">Rows</label>
        <select class="form-select" id="pageSize" name="pageSize">
            @foreach (var size in new[] { 5, 10, 25, 50 })
            {
                <option value="@size" selected="@(Model.PageSize == size)">@size</option>
            }
        </select>
    </div>
    <div class="col-12 col-lg-2 d-flex gap-2">
        <button type="submit" class="btn btn-quiet flex-grow-1">Apply</button>
        @if (Model.Filter.HasActiveFilters)
        {
            <a asp-action="Index" class="btn btn-link toolbar-clear px-2">Clear</a>
        }
    </div>

    <input type="hidden" name="page" value="1" />
    <input type="hidden" name="sortBy" value="@Model.Filter.SortBy" />
    <input type="hidden" name="sortOrder" value="@Model.Filter.SortOrder" />
</form>

<div class="panel">
    @if (Model.HasResults)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">
                            <a asp-action="Index" asp-all-route-data="Model.GetSortRouteValues(ProductSortBy.Name)"
                               class="th-sort" data-sorted="@(Model.IsSortedBy(ProductSortBy.Name) ? "true" : null)">
                                Name <i class="bi @Model.GetSortIcon(ProductSortBy.Name)"></i>
                            </a>
                        </th>
                        <th scope="col">Category</th>
                        <th scope="col" class="num">
                            <a asp-action="Index" asp-all-route-data="Model.GetSortRouteValues(ProductSortBy.Price)"
                               class="th-sort" data-sorted="@(Model.IsSortedBy(ProductSortBy.Price) ? "true" : null)">
                                Price <i class="bi @Model.GetSortIcon(ProductSortBy.Price)"></i>
                            </a>
                        </th>
                        <th scope="col" class="num">Stock</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="num">
                            <a asp-action="Index" asp-all-route-data="Model.GetSortRouteValues(ProductSortBy.CreatedDate)"
                               class="th-sort" data-sorted="@(Model.IsSortedBy(ProductSortBy.CreatedDate) ? "true" : null)">
                                Created <i class="bi @Model.GetSortIcon(ProductSortBy.CreatedDate)"></i>
                            </a>
                        </th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                <span class="cell-title">@product.Name</span>
                                @if (!string.IsNullOrEmpty(product.Description))
                                {
                                    <small class="cell-sub">@(product.Description.Length > 60 ? product.Description[..60] + "…" : product.Description)</small>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(product.Category))
                                {
                                    <span class="tag">@product.Category</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="num">@product.Price.ToString("N2")</td>
                            <td class="num">@product.StockQuantity</td>
                            <td>@product.CustomerName</td>
                            <td>
                                @if (!product.IsAvailable)
                                {
                                    <span class="status status-neutral">Unavailable</span>
                                }
                                else if (!product.IsInStock)
                                {
                                    <span class="status status-danger">Out of stock</span>
                                }
                                else
                                {
                                    <span class="status status-positive">Available</span>
                                }
                            </td>
                            <td class="num">@product.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn-icon"
                                       data-bs-toggle="tooltip" title="View details" aria-label="View @product.Name">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn-icon"
                                       data-bs-toggle="tooltip" title="Edit" aria-label="Edit @product.Name">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn-icon is-danger"
                                       data-bs-toggle="tooltip" title="Delete" aria-label="Delete @product.Name">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="panel-foot">
            <span class="result-count">@Model.StartItem–@Model.EndItem of @Model.TotalItems</span>

            @if (Model.HasMultiplePages)
            {
                <nav aria-label="Products pages">
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="Model.GetPageRouteValues(1)" aria-label="First page">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="Model.GetPageRouteValues(Model.CurrentPage - 1)" aria-label="Previous page">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @{
                            var startPage = Math.Max(1, Model.CurrentPage - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                        }
                        @for (var i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-all-route-data="Model.GetPageRouteValues(i)">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="Model.GetPageRouteValues(Model.CurrentPage + 1)" aria-label="Next page">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="Model.GetPageRouteValues(Model.TotalPages)" aria-label="Last page">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
    else
    {
        <div class="empty">
            <i class="bi bi-box-seam" aria-hidden="true"></i>
            <h2>@Model.NoResultsMessage</h2>
            @if (Model.Filter.HasActiveFilters)
            {
                <p>Widen the search or clear the filters to see the full catalogue.</p>
                <a asp-action="Index" class="btn btn-quiet">Clear filters</a>
            }
            else
            {
                <p>Add a product and it will show up here with its stock level and owner.</p>
                <a asp-action="Create" class="btn btn-primary">Add the first product</a>
            }
        </div>
    }
</div>
