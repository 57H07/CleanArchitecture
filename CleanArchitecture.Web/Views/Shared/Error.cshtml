@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page-head">
    <h1>Something went wrong</h1>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="panel panel-pad">
            <div class="alert-inline mb-4">
                <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
                <div>The request could not be completed. Nothing was saved.</div>
            </div>

            @if (Model.ShowRequestId)
            {
                <dl class="row detail-list mb-4">
                    <dt class="col-sm-3">Request ID</dt>
                    <dd class="col-sm-9 mb-0"><code>@Model.RequestId</code></dd>
                </dl>
            }

            <p class="text-muted mb-4" style="font-size: .875rem">
                Running with <code>ASPNETCORE_ENVIRONMENT=Development</code> replaces this page with the full
                exception detail. Keep it out of deployed environments: it exposes information from the exception
                to whoever hits the page.
            </p>

            <div class="form-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-link px-0">
                    <i class="bi bi-chevron-left"></i> Back to home
                </a>
            </div>
        </div>
    </div>
</div>
