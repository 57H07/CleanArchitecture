<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Clean Architecture Demo</title>

    <script src="~/js/theme-init.js" asp-append-version="true"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <header class="app-nav">
        <nav class="container navbar navbar-expand-md p-0" aria-label="Main">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">CA</span> Clean Architecture Demo
            </a>

            <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav gap-1 py-2 py-md-0">
                    <li class="nav-item">
                        <a class="nav-link" aria-current="@ViewContext.AriaCurrent("Home", "Index")" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" aria-current="@ViewContext.AriaCurrent("Products")" asp-controller="Products" asp-action="Index">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" aria-current="@ViewContext.AriaCurrent("Customers")" asp-controller="Customers" asp-action="Index">Customers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" aria-current="@ViewContext.AriaCurrent("Home", "Privacy")" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                </ul>

                <div class="ms-md-auto py-2 py-md-0">
                    <button id="themeToggleBtn" class="theme-toggle" type="button" title="Change theme">
                        <i id="themeIcon" class="bi bi-circle-half" aria-hidden="true"></i>
                        <span id="themeLabel">Auto</span>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <partial name="_Toast" />

    <main role="main" class="container py-4">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; 2026 Clean Architecture Demo</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
