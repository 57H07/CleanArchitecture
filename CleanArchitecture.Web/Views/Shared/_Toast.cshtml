@{
    ToastMessage? success = ToastMessage.Deserialize(TempData[ToastMessage.SuccessKey]);
    ToastMessage? error = ToastMessage.Deserialize(TempData[ToastMessage.ErrorKey]);

    // If a request managed to signal both, the failure is what the user needs to know.
    ToastMessage? toast = error ?? success;
    var isError = error != null;

    var toastColor = isError ? "danger" : "success";
    var toastIcon = isError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";
}

@if (toast != null && !string.IsNullOrEmpty(toast.Message))
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1100">
        <div id="infoToast" class="toast toast--@toastColor" role="alert" aria-live="assertive" aria-atomic="true">

            <div class="toast-header">
                <i class="bi @toastIcon me-2"></i>
                <strong class="me-auto">@toast.Header</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>

            <div class="toast-body">
                @toast.Message
            </div>
        </div>
    </div>
}
