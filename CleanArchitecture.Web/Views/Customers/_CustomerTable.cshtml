@using CleanArchitecture.Application.Enums
@using System.Text.Json
@model CleanArchitecture.Web.ViewModels.CustomersViewModel

<div id="customerTableContainer">
    @if (Model.HasResults)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a href="#" class="text-white text-decoration-none customer-sort-link" data-route="@JsonSerializer.Serialize(Model.GetSortRouteValues(CustomerSortBy.Name))">
                                Name <i class="bi @Model.GetSortIcon(CustomerSortBy.Name)"></i>
                            </a>
                        </th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>
                            <a href="#" class="text-white text-decoration-none customer-sort-link" data-route="@JsonSerializer.Serialize(Model.GetSortRouteValues(CustomerSortBy.Company))">
                                Company <i class="bi @Model.GetSortIcon(CustomerSortBy.Company)"></i>
                            </a>
                        </th>
                        <th>Status</th>
                        <th>
                            <a href="#" class="text-white text-decoration-none customer-sort-link" data-route="@JsonSerializer.Serialize(Model.GetSortRouteValues(CustomerSortBy.CreatedDate))">
                                Created <i class="bi @Model.GetSortIcon(CustomerSortBy.CreatedDate)"></i>
                            </a>
                        </th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td><strong>@customer.Name</strong></td>
                            <td>@customer.Email</td>
                            <td>@(customer.Phone ?? "-")</td>
                            <td>@(customer.Company ?? "-")</td>
                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@customer.CreatedAt.ToString("MM/dd/yyyy")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-outline-warning customer-edit-btn" data-id="@customer.Id">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger customer-delete-btn" data-id="@customer.Id" data-name="@customer.Name">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted small">
                Showing @Model.StartItem-@Model.EndItem of @Model.TotalItems customers
            </div>

            @if (Model.HasMultiplePages)
            {
                <nav aria-label="Customers pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link customer-page-link" href="#" data-route="@JsonSerializer.Serialize(Model.GetPageRouteValues(1))">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link customer-page-link" href="#" data-route="@JsonSerializer.Serialize(Model.GetPageRouteValues(Model.CurrentPage - 1))">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @{
                            var startPage = Math.Max(1, Model.CurrentPage - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                        }
                        @for (var i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link customer-page-link" href="#" data-route="@JsonSerializer.Serialize(Model.GetPageRouteValues(i))">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link customer-page-link" href="#" data-route="@JsonSerializer.Serialize(Model.GetPageRouteValues(Model.CurrentPage + 1))">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link customer-page-link" href="#" data-route="@JsonSerializer.Serialize(Model.GetPageRouteValues(Model.TotalPages))">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h4 class="text-muted">@Model.NoResultsMessage</h4>
            <p class="text-muted">Try adjusting your filters, or create your first customer to get started.</p>
            <button type="button" class="btn btn-primary" id="customerEmptyCreateBtn">
                <i class="bi bi-plus-circle"></i> New Customer
            </button>
        </div>
    }
</div>
