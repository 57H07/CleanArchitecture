@using CleanArchitecture.Application.Enums
@using System.Text.Json
@model CleanArchitecture.Web.ViewModels.CustomersViewModel

@* The page head and the toolbar sit outside the swapped region: they follow this partial through these attributes. *@
<div id="customerTableContainer"
     data-count-label="@Model.TotalItems @(Model.TotalItems == 1 ? "customer" : "customers")"
     data-has-filters="@(Model.Filter.HasActiveFilters ? "true" : "false")">
    @if (Model.HasResults)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">
                            <a href="#" class="th-sort" data-action="navigate"
                               data-sorted="@(Model.IsSortedBy(CustomerSortBy.Name) ? "true" : null)"
                               data-route="@JsonSerializer.Serialize(Model.GetSortRouteValues(CustomerSortBy.Name))">
                                Name <i class="bi @Model.GetSortIcon(CustomerSortBy.Name)"></i>
                            </a>
                        </th>
                        <th scope="col">Email</th>
                        <th scope="col">Phone</th>
                        <th scope="col">
                            <a href="#" class="th-sort" data-action="navigate"
                               data-sorted="@(Model.IsSortedBy(CustomerSortBy.Company) ? "true" : null)"
                               data-route="@JsonSerializer.Serialize(Model.GetSortRouteValues(CustomerSortBy.Company))">
                                Company <i class="bi @Model.GetSortIcon(CustomerSortBy.Company)"></i>
                            </a>
                        </th>
                        <th scope="col">Status</th>
                        <th scope="col" class="num">
                            <a href="#" class="th-sort" data-action="navigate"
                               data-sorted="@(Model.IsSortedBy(CustomerSortBy.CreatedDate) ? "true" : null)"
                               data-route="@JsonSerializer.Serialize(Model.GetSortRouteValues(CustomerSortBy.CreatedDate))">
                                Created <i class="bi @Model.GetSortIcon(CustomerSortBy.CreatedDate)"></i>
                            </a>
                        </th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td><span class="cell-title">@customer.Name</span></td>
                            <td>@customer.Email</td>
                            <td>@(string.IsNullOrEmpty(customer.Phone) ? "—" : customer.Phone)</td>
                            <td>@(string.IsNullOrEmpty(customer.Company) ? "—" : customer.Company)</td>
                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="status status-positive">Active</span>
                                }
                                else
                                {
                                    <span class="status status-neutral">Inactive</span>
                                }
                            </td>
                            <td class="num">@customer.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="row-actions">
                                    <button type="button" class="btn-icon" data-action="edit"
                                            data-url="@Url.Action("Form", new { id = customer.Id })"
                                            data-bs-toggle="tooltip" title="Edit" aria-label="Edit @customer.Name">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn-icon is-danger" data-action="delete"
                                            data-url="@Url.Action("Delete", new { id = customer.Id })" data-name="@customer.Name"
                                            data-bs-toggle="tooltip" title="Delete" aria-label="Delete @customer.Name">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="panel-foot">
            <span class="result-count">@Model.StartItem–@Model.EndItem of @Model.TotalItems</span>

            @if (Model.HasMultiplePages)
            {
                <nav aria-label="Customers pages">
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" data-action="navigate" href="#" aria-label="First page"
                               data-route="@JsonSerializer.Serialize(Model.GetPageRouteValues(1))">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" data-action="navigate" href="#" aria-label="Previous page"
                               data-route="@JsonSerializer.Serialize(Model.GetPageRouteValues(Model.CurrentPage - 1))">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @{
                            var startPage = Math.Max(1, Model.CurrentPage - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                        }
                        @for (var i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" data-action="navigate" href="#"
                                   data-route="@JsonSerializer.Serialize(Model.GetPageRouteValues(i))">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" data-action="navigate" href="#" aria-label="Next page"
                               data-route="@JsonSerializer.Serialize(Model.GetPageRouteValues(Model.CurrentPage + 1))">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" data-action="navigate" href="#" aria-label="Last page"
                               data-route="@JsonSerializer.Serialize(Model.GetPageRouteValues(Model.TotalPages))">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
    else
    {
        <div class="empty">
            <i class="bi bi-person-vcard" aria-hidden="true"></i>
            <h2>@Model.NoResultsMessage</h2>
            @if (Model.Filter.HasActiveFilters)
            {
                <p>Widen the search or clear the filters to see the full directory.</p>
                <a href="@Url.Action("Index", "Customers")" class="btn btn-quiet" data-action="clear-filters">Clear filters</a>
            }
            else
            {
                <p>Add a customer and it will show up here, ready to own products.</p>
                <button type="button" class="btn btn-primary" data-action="create" data-url="@Url.Action("Form")">Add the first customer</button>
            }
        </div>
    }
</div>
