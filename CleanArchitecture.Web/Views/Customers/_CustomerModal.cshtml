@* Single modal reused for both Create and Edit. customers.js toggles its mode/title and (re)populates fields. *@
<div class="modal fade" id="customerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="customerForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="customerId" name="Id" value="" />
                <div class="modal-header">
                    <h5 class="modal-title" id="customerModalLabel">New Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div data-valmsg-summary class="alert alert-danger" hidden></div>

                    <div class="mb-3">
                        <label class="form-label" for="customerName">Name</label>
                        <input type="text" class="form-control" id="customerName" name="Name" maxlength="200" required />
                        <div class="text-danger small" data-valmsg-for="Name"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="customerEmail">Email</label>
                        <input type="email" class="form-control" id="customerEmail" name="Email" maxlength="256" required />
                        <div class="text-danger small" data-valmsg-for="Email"></div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="customerPhone">Phone</label>
                            <input type="text" class="form-control" id="customerPhone" name="Phone" maxlength="30" />
                            <div class="text-danger small" data-valmsg-for="Phone"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="customerCompany">Company</label>
                            <input type="text" class="form-control" id="customerCompany" name="Company" maxlength="200" />
                            <div class="text-danger small" data-valmsg-for="Company"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="customerNotes">Notes</label>
                        <textarea class="form-control" id="customerNotes" name="Notes" rows="3" maxlength="1000"></textarea>
                        <div class="text-danger small" data-valmsg-for="Notes"></div>
                    </div>

                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" id="customerIsActive" name="IsActive" value="true" checked />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label" for="customerIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="customerSubmitBtn">
                        <span class="spinner-border spinner-border-sm d-none me-1" id="customerSubmitSpinner" role="status" aria-hidden="true"></span>
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="customerDeleteModal" tabindex="-1" aria-labelledby="customerDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customerDeleteModalLabel">Delete Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong id="customerDeleteName"></strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="customerDeleteConfirmBtn">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="customerDeleteSpinner" role="status" aria-hidden="true"></span>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>
