@model CleanArchitecture.Application.DTOs.CreateCustomerDto

@{
    var customerId = ViewData["CustomerId"] as int?;
    var isEdit = customerId.HasValue;
}

<form id="customerForm" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@customerId">
    <div class="modal-header">
        <h2 class="modal-title" id="customerModalLabel">@(isEdit ? "Edit customer" : "New customer")</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="validation-summary mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Company" class="form-label"></label>
                <input asp-for="Company" class="form-control" />
                <span asp-validation-for="Company" class="field-error"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="field-error"></span>
        </div>

        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Active customer</label>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" id="customerSubmitBtn">
            <span class="spinner-border spinner-border-sm d-none me-1" id="customerSubmitSpinner" role="status" aria-hidden="true"></span>
            Save customer
        </button>
    </div>
</form>
